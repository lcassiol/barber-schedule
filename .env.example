# PostgreSQL is internal to Compose. Change both passwords before deployment.
POSTGRES_DB=barber
POSTGRES_USER=barber
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgres://barber:replace-with-a-long-random-database-password@db:5432/barber
PUBLIC_APP_URL=http://localhost:3000
SCHEDULE_TIMEZONE=America/Sao_Paulo
BARBER_NAME=Nome da Barbearia
BARBER_SLUG=oficio-barber
# Local demo login. Replace both values before deploying publicly.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=local-admin-password-not-for-production
